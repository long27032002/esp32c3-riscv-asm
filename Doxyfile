# Doxygen configuration for the ESP32-C3 assembly template - ENGLISH.
#
# This is the base configuration. Doxyfile.vi includes it and overrides only
# the few settings that differ, so there is one place to edit everything else.
#
# Build both languages at once:  ./tools/build-docs.sh
# Build this one alone:          doxygen Doxyfile
# Output:                        docs/html/en/index.html

PROJECT_NAME           = "ESP32-C3 RISC-V Assembly Template"
PROJECT_BRIEF          = "Bare-register assembly on the ESP32-C3, documented"
PROJECT_NUMBER         = 1.0.0
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English

# Both READMEs are listed so the language-switch link between them resolves;
# leaving one out makes Doxygen warn about an unresolvable \ref.
INPUT                  = components examples \
                         README.md README.vi.md

# templates/ is deliberately left out: those files carry @PLACEHOLDER@ markers
# that tools/new-project.sh substitutes, and Doxygen reads a leading @ as the
# start of a command ("Found unknown command '@PROJECT_NAME'").
USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */managed_components/* \
                         */examples/*/components/riscv_asm/*

# Doxygen has no assembly parser. Mapping .S to the C parser is what makes the
# /** ... */ blocks in the .S files show up in the generated documentation.
FILE_PATTERNS          = *.c *.h *.S
EXTENSION_MAPPING      = S=C

# Assembly labels are not C declarations, so the @fn blocks are the only
# source of signatures: keep everything, document even what Doxygen cannot
# parse by itself.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES

# @clobber is not a built-in command. Define it as an alias so the register
# clobber lists in the .S files render as a proper documentation section.
ALIASES                = "clobber=@par Clobbers:^^"
AUTOLINK_SUPPORT       = YES

# Preprocessing: without this the peripheral #defines in the .S files are
# expanded and the documentation shows raw numbers instead of names.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = NO

# Declared explicitly rather than left to the default: the default differs
# between Doxygen builds, and a Doxyfile that silently needs Graphviz on one
# machine and not on another produces "Problems running dot: exit code=127"
# for anyone without it. tools/build-docs.sh turns graphs back on when it
# finds dot, so nothing is lost where Graphviz is installed.
HAVE_DOT               = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_OUTPUT            = html/en
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
