{
    // ---------------------------------------------------------------------
    // GENERATED BY tools/setup.sh - DO NOT EDIT BY HAND.
    // ---------------------------------------------------------------------
    "version": "0.2.0",
    "configurations": [
        {
            // Default: press F5. The "openocd" task starts OpenOCD with
            // absolute paths, so it works whether or not the ESP-IDF
            // extension has a registered installation of its own.
            "name": "Debug (task starts OpenOCD)",
            "type": "gdbtarget",
            "request": "attach",
            "preLaunchTask": "openocd",
            "runOpenOCD": false,
            "gdb": "@GDB_BIN@",
            "program": "${workspaceFolder}/build/@PROJECT_NAME@.elf",
            "cwd": "${workspaceFolder}",
            "openGdbConsole": true,
            "initialBreakpoint": "@INITIAL_BREAKPOINT@",
            "initCommands": [
                "set remotetimeout 20",
                "set print pretty on",
                "monitor reset halt",
                "maintenance flush register-cache"
            ],
            "target": {
                "connectCommands": [
                    "set remotetimeout 20",
                    "target extended-remote localhost:3333"
                ]
            }
        },
        {
            // No board required. qemu.sh builds into build-qemu/ with the
            // console moved to UART, because QEMU does not emulate
            // USB-Serial-JTAG and the board configuration would boot silent.
            //
            // Breakpoints, stepping, Disassembly and the MEMORY view all work.
            // The xRTOS task list does not: task awareness comes from
            // OpenOCD's -rtos support, and QEMU's gdbstub reports one thread
            // per emulated CPU instead. Timing and GPIO are not real either -
            // see the comment at the top of tools/qemu.sh.
            "name": "Debug on QEMU (no board)",
            "type": "gdbtarget",
            "request": "attach",
            "preLaunchTask": "qemu (gdb server)",
            "runOpenOCD": false,
            "gdb": "@GDB_BIN@",
            "program": "${workspaceFolder}/build-qemu/@PROJECT_NAME@.elf",
            "cwd": "${workspaceFolder}",
            "openGdbConsole": true,
            "initialBreakpoint": "@INITIAL_BREAKPOINT@",
            // initCommands run AFTER the connection is established. The debug
            // adapter connects first, then sends them:
            //
            //     if (connectCommands === undefined)
            //         -target-select remote <host>:<port>
            //     else
            //         sendCommands(connectCommands)
            //     sendCommands(initCommands)
            //
            // So this list must NOT contain "target remote": that connects a
            // second time and the session dies with "A program is being
            // debugged already", then "could not connect: Connection timed
            // out". For the same reason there is no connectCommands block -
            // "target" below is all the adapter needs to connect once.
            //
            // The extension prefixes defaults of its own, among them
            // "monitor reset halt". QEMU's gdb stub has no such monitor
            // command and answers "unknown command: 'reset'". That line is
            // harmless, cannot be suppressed from here, and nothing needs
            // resetting anyway: QEMU holds the CPU at the reset vector until
            // a debugger attaches.
            "initCommands": [
                "set remotetimeout 20",
                "set print pretty on"
            ],
            "target": {
                "host": "localhost",
                "port": "3333"
            }
        },
        {
            // Let the ESP-IDF extension start OpenOCD itself.
            // This only works once the extension knows about an ESP-IDF
            // installation (~/.espressif/esp_idf.json). If it is missing the
            // extension reports "OPENOCD_SCRIPTS environment variable is
            // missing" and offers to download its own installer.
            // Register one with: F1 -> "ESP-IDF: Configure ESP-IDF extension"
            //                      -> USE EXISTING SETUP -> @IDF_PATH@
            "name": "Debug (extension starts OpenOCD)",
            "type": "gdbtarget",
            "request": "attach",
            "runOpenOCD": true,
            "gdb": "@GDB_BIN@",
            "program": "${workspaceFolder}/build/@PROJECT_NAME@.elf",
            "cwd": "${workspaceFolder}",
            "openGdbConsole": true,
            "initialBreakpoint": "@INITIAL_BREAKPOINT@",
            "initCommands": [
                "set remotetimeout 20",
                "monitor reset halt",
                "maintenance flush register-cache"
            ],
            "target": {
                "connectCommands": [
                    "set remotetimeout 20",
                    "target extended-remote localhost:3333"
                ]
            }
        },
        {
            // Use when you start OpenOCD yourself in a terminal.
            "name": "Debug (OpenOCD already running)",
            "type": "gdbtarget",
            "request": "attach",
            "runOpenOCD": false,
            "gdb": "@GDB_BIN@",
            "program": "${workspaceFolder}/build/@PROJECT_NAME@.elf",
            "cwd": "${workspaceFolder}",
            "openGdbConsole": true,
            "initialBreakpoint": "@INITIAL_BREAKPOINT@",
            "initCommands": [
                "set remotetimeout 20",
                "monitor reset halt",
                "maintenance flush register-cache"
            ],
            "target": {
                "connectCommands": [
                    "set remotetimeout 20",
                    "target extended-remote localhost:3333"
                ]
            }
        }
    ]
}
