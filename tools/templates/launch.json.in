{
    // ---------------------------------------------------------------------
    // GENERATED BY tools/setup.sh - DO NOT EDIT BY HAND.
    // ---------------------------------------------------------------------
    "version": "0.2.0",
    "configurations": [
        {
            // Default: press F5. The "openocd" task starts OpenOCD with
            // absolute paths, so it works whether or not the ESP-IDF
            // extension has a registered installation of its own.
            "name": "Debug on board (task starts OpenOCD)",
            "type": "gdbtarget",
            "request": "attach",
            "preLaunchTask": "openocd",
            "runOpenOCD": false,
            "gdb": "@GDB_BIN@",
            "program": "${workspaceFolder}/build/@PROJECT_NAME@.elf",
            "cwd": "${workspaceFolder}",
            "openGdbConsole": true,
            "initialBreakpoint": "@INITIAL_BREAKPOINT@",
            "initCommands": [
                "set remotetimeout 20",
                "set print pretty on",
                "monitor reset halt",
                "maintenance flush register-cache"
            ],
            "target": {
                "connectCommands": [
                    "set remotetimeout 20",
                    "target extended-remote localhost:3333"
                ]
            }
        },
        // @QEMU_BLOCK_BEGIN@
        {
            // No board required. qemu.sh builds into build-qemu/ with the
            // console moved to UART, because QEMU does not emulate
            // USB-Serial-JTAG and the board configuration would boot silent.
            //
            // Breakpoints, stepping, Disassembly and the MEMORY view all work.
            // The xRTOS task list does not: task awareness comes from
            // OpenOCD's -rtos support, and QEMU's gdbstub reports one thread
            // per emulated CPU instead. Timing and GPIO are not real either -
            // see the comment at the top of tools/qemu.sh.
            "name": "Debug on QEMU (no board)",
            "type": "gdbtarget",
            "request": "attach",
            "preLaunchTask": "qemu (gdb server)",
            "runOpenOCD": false,
            // A wrapper that starts the real gdb with "-x" and a one-line
            // command file holding "set tdesc filename ...". The description
            // has to be in place before the connection, and -x runs before
            // anything else - no debug-adapter hook required. Doing it from
            // connectCommands instead replaced the adapter's own connect and
            // ended in "monitor command not supported by this target".
            "gdb": "@GDB_QEMU@",
            // The ESP-IDF extension gates three things on OpenOCD before a
            // session starts - starting it, checking it is up, and requiring
            // OPENOCD_SCRIPTS - and skips all three when the session is
            // marked as QEMU's:
            //
            //     sessionID !== "qemu.debug.session" && runOpenOCD !== false
            //
            // runOpenOCD: false above is already enough, but the two are
            // independent and this is the extension's own marker for a QEMU
            // session, so declare it as well. Without either, the session
            // fails with "OPENOCD_SCRIPTS environment variable is missing"
            // and "OpenOCD is not running", neither of which has anything to
            // do with the emulator.
            "sessionID": "qemu.debug.session",
            "program": "${workspaceFolder}/build-qemu/@PROJECT_NAME@.elf",
            "cwd": "${workspaceFolder}",
            "openGdbConsole": true,
            "initialBreakpoint": "@INITIAL_BREAKPOINT@",
            // Connecting is done by connectCommands, for one reason: the
            // target description has to be set BEFORE the connection, and
            // this is the only hook that runs that early. initCommands are
            // sent AFTER the adapter has connected:
            //
            //     if (connectCommands === undefined)
            //         -target-select remote <host>:<port>
            //     else
            //         sendCommands(connectCommands)
            //     sendCommands(initCommands)
            //
            // which is also why initCommands must contain no "target remote":
            // that connects a second time and the session dies with "A program
            // is being debugged already", then "could not connect: Connection
            // timed out".
            //
            // Why the description is overridden at all: QEMU advertises far
            // more CSRs than it will serve, and the Registers pane asks for
            // every register in one request, so a single refusal - the first
            // is "htimedelta" - empties the whole pane. See the comments in
            // tools/templates/riscv-qemu.xml, including what this costs.
            //
            // No reset command is needed: QEMU holds the CPU at the reset
            // vector until a debugger attaches, and its gdb stub has no
            // "monitor reset" anyway.
            "initCommands": [
                "set remotetimeout 20",
                "set print pretty on"
            ],
            "target": {
                "host": "localhost",
                "port": "3333"
            }
        },
        // @QEMU_BLOCK_END@
        {
            // Let the ESP-IDF extension start OpenOCD itself.
            // This only works once the extension knows about an ESP-IDF
            // installation (~/.espressif/esp_idf.json). If it is missing the
            // extension reports "OPENOCD_SCRIPTS environment variable is
            // missing" and offers to download its own installer.
            // Register one with: F1 -> "ESP-IDF: Configure ESP-IDF extension"
            //                      -> USE EXISTING SETUP -> @IDF_PATH@
            "name": "Debug on board (extension starts OpenOCD)",
            "type": "gdbtarget",
            "request": "attach",
            "runOpenOCD": true,
            "gdb": "@GDB_BIN@",
            "program": "${workspaceFolder}/build/@PROJECT_NAME@.elf",
            "cwd": "${workspaceFolder}",
            "openGdbConsole": true,
            "initialBreakpoint": "@INITIAL_BREAKPOINT@",
            "initCommands": [
                "set remotetimeout 20",
                "monitor reset halt",
                "maintenance flush register-cache"
            ],
            "target": {
                "connectCommands": [
                    "set remotetimeout 20",
                    "target extended-remote localhost:3333"
                ]
            }
        },
        {
            // Use when you start OpenOCD yourself in a terminal.
            "name": "Debug on board (OpenOCD already running)",
            "type": "gdbtarget",
            "request": "attach",
            "runOpenOCD": false,
            "gdb": "@GDB_BIN@",
            "program": "${workspaceFolder}/build/@PROJECT_NAME@.elf",
            "cwd": "${workspaceFolder}",
            "openGdbConsole": true,
            "initialBreakpoint": "@INITIAL_BREAKPOINT@",
            "initCommands": [
                "set remotetimeout 20",
                "monitor reset halt",
                "maintenance flush register-cache"
            ],
            "target": {
                "connectCommands": [
                    "set remotetimeout 20",
                    "target extended-remote localhost:3333"
                ]
            }
        }
    ]
}
