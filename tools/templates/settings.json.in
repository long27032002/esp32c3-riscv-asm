{
    // ---------------------------------------------------------------------
    // GENERATED BY tools/setup.sh - DO NOT EDIT BY HAND.
    // Re-run the script after moving ESP-IDF or changing boards.
    //
    // The ESP-IDF extension reads idf.* values VERBATIM: it does not expand
    // ${env:HOME} or any other variable. Every path below is therefore
    // absolute, resolved by the setup script from "idf.py export".
    // ---------------------------------------------------------------------
    "idf.espIdfPath": "@IDF_PATH@",
    "idf.toolsPath": "@IDF_TOOLS_PATH@",
    "idf.pythonBinPath": "@IDF_PYTHON@",
    "idf.currentSetup": "@IDF_PATH@",

    "idf.customOpenOCDPath": "@OPENOCD_BIN@",
    "idf.customExtraVars": {
        "OPENOCD_SCRIPTS": "@OPENOCD_SCRIPTS@"
    },
    "idf.openOcdConfigs": ["@OPENOCD_CFG@"],
    "idf.customExtraPaths": "@EXTRA_PATHS@",

    "idf.adapterTargetName": "@TARGET@",
    "idf.port": "@SERIAL_PORT@",
    "idf.flashType": "UART",

    // ---------------------------------------------------------------------
    // Debugger panels
    // ---------------------------------------------------------------------
    // The MEMORY panel (mcu-debug.memory-view) only tracks a fixed list of
    // debug types that does NOT include "gdbtarget". Without this line the
    // tab stays empty and reports no error.
    "memory-view.trackDebuggers": ["gdbtarget"],
    // The xRTOS panel (mcu-debug.rtos-views) already lists "gdbtarget" in its
    // defaults, so it needs no extra configuration.

    "debug.disassemblyView.showSourceCode": true,

    // ---------------------------------------------------------------------
    // Editing
    // ---------------------------------------------------------------------
    "files.associations": { "*.S": "asm-intel-x86-generic" },
    "C_Cpp.default.compilerPath": "@TOOLCHAIN_GCC@",

    // Both build directories are listed, and the setting takes an array for
    // exactly this reason. A QEMU session builds into build-qemu/, a board
    // session into build/, and whichever one has not been built yet simply
    // is not there. With a single path pointing at a missing file,
    // IntelliSense has no include paths at all and every ESP-IDF header it
    // opens turns into "cannot open source file soc/soc.h" - nine errors
    // from one absent file.
    "C_Cpp.default.compileCommands": [
        "${workspaceFolder}/build/compile_commands.json",
        "${workspaceFolder}/build-qemu/compile_commands.json"
    ],

    // ---------------------------------------------------------------------
    // Debugging
    // ---------------------------------------------------------------------
    // After a preLaunchTask, VS Code looks for error markers and asks
    // "Errors exist after running preLaunchTask" before it will start the
    // session. It does not check whether those errors have anything to do
    // with the task: IntelliSense complaints about an ESP-IDF source file
    // that happens to be open are enough to block F5. The task itself
    // reports its own failures on its terminal, so skip the prompt.
    "debug.onTaskErrors": "debugAnyway"
}
