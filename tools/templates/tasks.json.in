{
    // -------------------------------------------------------------------
    // GENERATED BY tools/setup.sh - DO NOT EDIT BY HAND.
    // -------------------------------------------------------------------
    "version": "2.0.0",
    "tasks": [
        {
            // Started automatically by the default debug configuration.
            //
            // OpenOCD listens on three ports (3333 gdb, 4444 telnet,
            // 6666 tcl). A single leftover process blocks the next run, and
            // the failure is reported on port 6666, which is confusing. We
            // therefore kill stale instances first and disable the two ports
            // we never use.
            //
            // "pkill -x openocd" matches the PROCESS NAME. Do not use
            // "pkill -f <path>": -f matches whole command lines, and the
            // command line of the shell running this very task contains the
            // OpenOCD path, so the task kills its own shell. The symptom is a
            // task that dies instantly with an empty terminal.
            "label": "openocd",
            "type": "shell",
            "command": "pkill -x openocd 2>/dev/null; sleep 0.5; exec '@OPENOCD_BIN@' -f '@OPENOCD_CFG@' -c 'tcl port disabled' -c 'telnet port disabled'",
            "options": {
                "env": { "OPENOCD_SCRIPTS": "@OPENOCD_SCRIPTS@" }
            },
            "isBackground": true,
            // A background task used as preLaunchTask needs a problem matcher,
            // otherwise VS Code cannot tell when the server is ready and pops
            // up "task has not exited...". An inline matcher must declare
            // owner and fileLocation, and its pattern must have kind "file" or
            // a line/location group. OpenOCD output has no file:line, so the
            // regexp below deliberately never matches: only the "background"
            // section matters here.
            "problemMatcher": {
                "owner": "openocd",
                "source": "openocd",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    {
                        "kind": "file",
                        "regexp": "^OPENOCD_NEVER_MATCHES__(.*)$",
                        "file": 1,
                        "message": 1
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Open On-Chip Debugger",
                    "endsPattern": "Listening on port 3333 for gdb connections"
                }
            },
            "runOptions": { "instanceLimit": 1 },
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "group": "debug",
                "close": true
            }
        },
        {
            // Started automatically by "Debug on QEMU". qemu.sh prints a
            // QEMU_READY line of its own once the port actually accepts a
            // connection: QEMU is silent when it stops at the reset vector,
            // so there is nothing else to wait for, and starting the debugger
            // too early fails with "Connection refused".
            //
            // QEMU's gdbstub listens on 3333, the same port as OpenOCD, so
            // qemu.sh kills a leftover OpenOCD before starting.
            "label": "qemu (gdb server)",
            "type": "shell",
            "command": "'@QEMU_SH@' --gdb --project '${workspaceFolder}'",
            "isBackground": true,
            "problemMatcher": {
                "owner": "qemu",
                "source": "qemu",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    {
                        "kind": "file",
                        "regexp": "^QEMU_NEVER_MATCHES__(.*)$",
                        "file": 1,
                        "message": 1
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*building|^QEMU,",
                    "endsPattern": "QEMU_READY"
                }
            },
            "runOptions": { "instanceLimit": 1 },
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "group": "debug",
                "close": true
            }
        },
        {
            // Run on the emulator with no debugger and no board attached.
            "label": "qemu (run)",
            "type": "shell",
            "command": "'@QEMU_SH@' --project '${workspaceFolder}'",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "build",
            "type": "shell",
            "command": ". '@IDF_PATH@/export.sh' >/dev/null && idf.py build",
            "problemMatcher": "$gcc",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "flash + monitor",
            "type": "shell",
            "command": ". '@IDF_PATH@/export.sh' >/dev/null && idf.py -p '@SERIAL_PORT@' flash monitor",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            // Recovery for a wedged debug module. Symptoms in the OpenOCD log:
            //   "Timed out ... waiting for busy to go low (abstractcs=0x...)"
            //   "Examination failed" / "Unsupported DTM version: -1"
            // Usually caused by a debug session that was cut off while the
            // target was halted. A plain hard reset only restarts the CPU and
            // is not enough; a watchdog reset restarts the whole digital core
            // and clears the debug module without unplugging the cable.
            "label": "recover JTAG (watchdog reset)",
            "type": "shell",
            "command": "pkill -x openocd 2>/dev/null; sleep 1; '@IDF_PYTHON@' -m esptool --chip @TARGET@ -p '@SERIAL_PORT@' --after watchdog_reset flash_id",
            "problemMatcher": [],
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "kill stray OpenOCD",
            "type": "shell",
            "command": "pkill -x openocd && echo killed || echo 'nothing running'",
            "problemMatcher": [],
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "docs (doxygen, en + vi)",
            "type": "shell",
            "command": "./tools/build-docs.sh && echo 'open docs/html/index.html'",
            "problemMatcher": [],
            "presentation": { "panel": "shared", "reveal": "always" }
        }
    ]
}
