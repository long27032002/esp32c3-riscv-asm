# ESP-IDF build output, anywhere in the tree
build/
managed_components/
dependencies.lock

# Component archives produced by "compote component pack"
dist/

# Per-machine configuration, generated from sdkconfig.defaults by the build.
# Never commit it: it hardcodes toolchain paths of whoever built last.
sdkconfig
sdkconfig.old

# Generated by tools/setup.sh (and setup.ps1) with machine-specific absolute
# paths and the serial port of one particular board. Each user regenerates
# these by running the setup script, so they must stay out of the repository.
**/.vscode/settings.json
**/.vscode/launch.json
**/.vscode/tasks.json
**/.vscode/*.bak
# .vscode/extensions.json IS committed on purpose: it lists extension ids
# only, no paths, and makes VS Code offer to install them on first open.

# Doxygen output
docs/html/
docs/latex/

# Editor and OS noise
*.swp
*~
.DS_Store
