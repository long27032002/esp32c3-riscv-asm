# ESP-IDF build output
build/
managed_components/
dependencies.lock

# Per-machine configuration, generated from sdkconfig.defaults by the build.
# Never commit it: it hardcodes toolchain paths of whoever built last.
sdkconfig
sdkconfig.old

# Generated by tools/setup.sh (and setup.ps1) with machine-specific absolute
# paths and the serial port of one particular board. Each user regenerates
# these by running the setup script, so they must stay out of the repository.
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.bak

# Doxygen output
docs/html/
docs/latex/

# Editor and OS noise
*.swp
*~
.DS_Store
